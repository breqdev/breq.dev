---
import {
  faHeart,
  faEnvelope,
  faChevronRight,
  faCode,
  type IconDefinition,
  faRssSquare,
  faAddressCard,
} from "@fortawesome/free-solid-svg-icons";
import { faCopyright } from "@fortawesome/free-regular-svg-icons";
import {
  faBluesky,
  faGithub,
  faMastodon,
} from "@fortawesome/free-brands-svg-icons";

import FaIcon from "./FaIcon.astro";
import { BADGES } from "../utils/badges";

import Computer from "./Computer";

const contactLinks: [IconDefinition, string, string, string][] = [
  [
    faEnvelope,
    "breq@breq.dev",
    "mailto:breq@breq.dev",
    "hover:!bg-panpink-light focus:!bg-panpink-light hover:text-black focus:text-black",
  ],
  [
    faBluesky,
    "@breq.dev",
    "https://bsky.app/profile/breq.dev",
    "hover:!bg-panyellow-light focus:!bg-panyellow-light hover:text-black focus:text-black",
  ],
  [
    faMastodon,
    "@breq@tacobelllabs.net",
    "https://tacobelllabs.net/@breq",
    "hover:!bg-brookepurple-light focus:!bg-brookepurple-light hover:text-black focus:text-black",
  ],
  [
    faRssSquare,
    "rss",
    "https://breq.dev/rss.xml",
    "hover:!bg-brookeorange-light focus:!bg-brookeorange-light hover:text-black focus:text-black",
  ],
  [
    faAddressCard,
    "vcf",
    "https://breq.dev/vcard/breq.vcf",
    "hover:!bg-brookegreen-light focus:!bg-brookegreen-light hover:text-black focus:text-black",
  ],
];

const linkStyles =
  "outline-none whitespace-nowrap cursor-pointer px-2 py-0.5 rounded-lg transition-colors duration-300";
---

<footer
  id="footer"
  class="z-10 font-display text-lg transition-colors duration-500 print:hidden"
  style={{
    "--text-color": "#1E2939",
    "--bg-color": "#1BB3FF",
    "--light-bg-color": "#5EC9FF",
    color: "var(--text-color)",
    backgroundColor: "var(--bg-color)",
  }}
>
  <div
    class="mx-auto grid max-w-7xl grid-cols-1 gap-6 px-4 pb-16 pt-12 lg:grid-cols-[1fr_12rem]"
  >
    <div class="flex flex-col gap-6">
      <p>
        made with <FaIcon icon={faCode} />{" "}
        <span class="sr-only">code</span> and{" "}
        <FaIcon icon={faHeart} />
        <span class="sr-only">love</span> by breq,{" "}
        <FaIcon icon={faCopyright} />
        <span class="sr-only">copyright</span>&nbsp;
        {new Date().getFullYear()},{" "}
        <a
          href="https://github.com/breqdev/breq.dev"
          class={`${linkStyles} hover:bg-gray-800! hover:text-white focus:bg-gray-800! focus:text-white`}
          style={{ backgroundColor: "var(--light-bg-color)" }}
        >
          <FaIcon icon={faGithub} class="-ml-0.5 mr-1" />
          <span class="sr-only">github.com/</span>
          breqdev/breq.dev
        </a>
      </p>
      <ul class="flex list-none flex-row flex-wrap gap-1">
        {
          contactLinks.map(([icon, text, href, colors]) => (
            <li class="contents">
              <a
                href={href}
                class={`${linkStyles} ${colors}`}
                style={{ backgroundColor: "var(--light-bg-color)" }}
              >
                <FaIcon icon={icon} class="mr-1" />
                <span>{text}</span>
              </a>
            </li>
          ))
        }
        <li class="contents">
          <a
            href="/contact"
            class={`${linkStyles} hover:bg-white! hover:text-gray-800 focus:bg-white! focus:text-gray-800`}
            style={{ backgroundColor: "var(--light-bg-color)" }}
          >
            more<span class="sr-only"> ways to contact me </span>
            <FaIcon class="ml-1" icon={faChevronRight} />
          </a>
        </li>
      </ul>

      <ul
        class="flex list-none flex-wrap items-start justify-center gap-2 sm:justify-start"
      >
        {
          BADGES.map((badge) => (
            <li class="contents">
              <a
                href={badge.url}
                style={{ imageRendering: "pixelated", width: 88, height: 31 }}
                class="footer-badge shrink-0 outline-panpink focus-visible:outline-4 oneko-hitbox"
                rel={badge.rel}
                data-color={badge.color}
                data-oneko-hitbox-alt={badge.alt}
              >
                {badge.image && (
                  <img
                    width="88px"
                    height="31px"
                    src={badge.image}
                    alt={
                      badge.tag ? `${badge.tag} (${badge.name})` : badge.name
                    }
                  />
                )}
              </a>
            </li>
          ))
        }
        <li>
          <a
            class="hidden h-7.75 w-22 cursor-pointer items-center justify-center whitespace-nowrap border-2 border-dashed px-2 py-0.5 text-base focus-visible:outline-4 outline-panpink sm:flex"
            href="/directory"
            style={{
              color: "var(--text-color)",
              borderColor: "var(--text-color)",
            }}
          >
            directory
            <FaIcon class="ml-0.5" icon={faChevronRight} />
          </a>
        </li>
      </ul>

      <script>
        const footer = document.getElementById("footer")!;

        // https://stackoverflow.com/a/41491220
        function useDarkText(bgColor: string) {
          var color =
            bgColor.charAt(0) === "#" ? bgColor.substring(1, 7) : bgColor;
          var r = parseInt(color.substring(0, 2), 16); // hexToR
          var g = parseInt(color.substring(2, 4), 16); // hexToG
          var b = parseInt(color.substring(4, 6), 16); // hexToB
          var uicolors = [r / 255, g / 255, b / 255];
          var c = uicolors.map((col) => {
            if (col <= 0.03928) {
              return col / 12.92;
            }
            return Math.pow((col + 0.055) / 1.055, 2.4);
          });
          var L = 0.2126 * c[0] + 0.7152 * c[1] + 0.0722 * c[2];
          return L > 0.179;
        }

        function lighten(color: string) {
          const amount = 0.705; // tuned to match the amount of lightening between the normal and light shade of panblue

          color = color.slice(1);

          var num = parseInt(color, 16);
          var r = (num >> 16) * amount + 255 * (1 - amount);

          if (r > 255) r = 255;
          else if (r < 0) r = 0;

          var b = ((num >> 8) & 0x00ff) * amount + 255 * (1 - amount);

          if (b > 255) b = 255;
          else if (b < 0) b = 0;

          var g = (num & 0x0000ff) * amount + 255 * (1 - amount);

          if (g > 255) g = 255;
          else if (g < 0) g = 0;

          return "#" + (g | (b << 8) | (r << 16)).toString(16);
        }

        document
          .querySelectorAll<HTMLAnchorElement>(".footer-badge")
          .forEach((badge) => {
            badge.addEventListener("mouseover", () => {
              const color = badge.dataset.color;
              if (color) {
                footer.style.setProperty(
                  "--text-color",
                  useDarkText(color) ? "#1E2939" : "#ffffff",
                );
                footer.style.setProperty("--bg-color", color);
                footer.style.setProperty("--light-bg-color", lighten(color));
              }
            });

            const altUrl = badge.dataset.onekoHitboxAlt;
            const badgeImg = badge.firstChild as HTMLImageElement | null;
            if (altUrl && badgeImg) {
              badge.addEventListener("oneko", () => {
                badgeImg.src = altUrl;
              });
            }
          });
      </script>
    </div>

    <div class="hidden flex-row items-end justify-end gap-3 self-end lg:flex">
      <button
        class="hidden rounded border-black bg-gray-200 px-1 py-0.5 text-center text-xs text-black hover:bg-gray-400 focus-visible:bg-gray-400"
        id="makeItMoreGreen"
      >
        make it more green
      </button>

      <img
        draggable="false"
        id="turtle"
        src="https://tris.fyi/static/turtlesbian.png"
        class="hidden z-60 h-8 w-8 cursor-grabbing"
        alt=""
      />
      <div
        class="h-8 w-8 hidden"
        style={{
          imageRendering: "pixelated",
          backgroundImage: "url(/oneko.gif)",
          backgroundPosition: `${-3 * 32}px ${-3 * 32}px`,
        }}
        id="oneko-trigger"
      >
      </div>

      <script>
        import oneko from "../utils/oneko.js";
        import turtle from "../utils/turtle";

        const turtleEl = document.getElementById("turtle");

        if (new URL(document.referrer).hostname.endsWith("tris.fyi")) {
          // visible only in tris mode
          turtleEl?.classList.remove("hidden");
          document
            .getElementById("makeItMoreGreen")
            ?.classList.remove("hidden");

          // green button
          document
            .getElementById("makeItMoreGreen")
            ?.addEventListener("click", () => {
              alert(
                'You will be redirected momentarily. Please drag the slider to "green" on the new tab. It is about 1/3 of the way on the hue slider',
              );
              window.location.href = "https://orb.breq.dev/";
            });

          // turtle interactivity
          turtle(turtleEl as HTMLImageElement);
        } else {
          const trigger = document.getElementById("oneko-trigger")!;
          trigger.classList.remove("hidden");

          const url = new URL(window.location.href);

          if (
            url.searchParams.has("catx") &&
            url.searchParams.has("caty") &&
            url.searchParams.has("catdx") &&
            url.searchParams.has("catdy")
          ) {
            // Launch cat immediately
            trigger.style.opacity = "0";
            // Positions are usually overwritten by URL parameters
            oneko(32, 32, false);
          } else {
            // Launch cat at trigger position
            trigger.addEventListener("click", (e: MouseEvent) => {
              const bbox = trigger.getBoundingClientRect();
              trigger.style.opacity = "0";
              oneko(bbox.x + bbox.width / 2, bbox.y + bbox.height / 2, true);
            });
          }
        }
      </script>

      <Computer client:load />
    </div>
  </div>
</footer>
