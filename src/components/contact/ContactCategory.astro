---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section>
  <div class="relative flex flex-row justify-center">
    <h2 class="relative z-10 mb-8 bg-white px-4 text-4xl dark:bg-black">
      {title}
    </h2>
    <div
      class="absolute left-0 right-0 top-6 h-8 rounded-t-2xl border-x-2 border-t-2 border-gray-400"
    >
    </div>
  </div>
  <div
    class="grid grid-cols-1 place-items-stretch justify-center gap-8 lg:grid-cols-2"
  >
    <slot />
  </div>
</section>
