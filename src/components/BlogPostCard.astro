---
import type { InferEntrySchema } from "astro:content";
import { getDateLabel, getPostUrl } from "../utils/dates";
import { render } from "astro:content";

interface Props {
  post: { id: string; data: InferEntrySchema<"posts">; collection: "posts" };
}

const { post } = Astro.props;

const dateLabel = getDateLabel(post.id);
const url = getPostUrl(post.id);

const { remarkPluginFrontmatter } = await render(post);
---

<a href={url} class="group relative outline-none">
  <section
    class="relative z-20 flex h-full flex-col gap-1 rounded-2xl border-4 border-black bg-white p-4 text-left text-black group-focus:border-panpink md:gap-0"
  >
    <h2 class="text-2xl md:mb-2 md:text-4xl">{post.data.title}</h2>
    <p class="shrink-0 text-left text-sm text-gray-800 md:hidden">
      {dateLabel}
    </p>
    <p class="md:text-lg">{post.data.description}</p>
    <div class="mt-2 hidden flex-row gap-2 md:flex">
      <p class="self-center">{dateLabel}</p>
      <div class="my-1.5 w-0.5 self-stretch bg-gray-200"></div>
      <p>{Math.round(remarkPluginFrontmatter.wordCount / 100) * 100} words</p>
      <div class="my-1.5 w-0.5 self-stretch bg-gray-200"></div>
      {
        post.data.tags?.map((tag) => (
          <span class="inline-block whitespace-nowrap rounded-full bg-panblue-light px-3 py-1 text-sm text-black">
            {tag}
          </span>
        ))
      }
    </div>
  </section>
  <div
    class="absolute inset-0 z-10 transform rounded-2xl bg-panpink group-hover:translate-x-3 group-hover:translate-y-3 group-focus:translate-x-4 group-focus:translate-y-2 motion-safe:transition-transform"
  >
  </div>
</a>
