                {p.data.title.toLocaleLowerCase()} <span class="arrow">→</span>
              </a>
            </li>
          ))
        }
      </ul>
      <h2>my friends</h2>
      <p>some really cool people</p>

      <style>
        .buttons {
          display: flex;
          flex-wrap: wrap;
          gap: 8px;
          margin: rem(1) 0;
        }

        .buttons img {
          border-radius: 0;
          image-rendering: pixelated;
        }

        .buttons a {
          display: inline-flex;
          text-decoration: none;
        }
        .links {
          margin: rem(1) 0;
        }
        .links span {
          display: inline-block;
        }
      </style>

      <div class="buttons">
        {
          BADGES.map((badge) => (
            <a href={badge.url}>
              <img
                src={badge.image}
                alt={badge.tag ? `${badge.tag} (${badge.name})` : badge.name}
                width="88px"
                height="31px"
              />
            </a>
          ))
        }
      </div>
      <h2>contact me</h2>
      <p>ask me a question, or show me something cool you've made!</p>
      <p class="fancy-link">
        <a href="mailto:breq@breq.dev">email <span class="arrow">→</span></a>
