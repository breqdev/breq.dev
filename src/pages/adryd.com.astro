---
import { getCollection } from "astro:content";
import { BADGES } from "../utils/badges";

const projects = await getCollection("projects");
const displayedProjects = projects
  .sort((a, b) => b.data.writeup.getTime() - a.data.writeup.getTime())
  .slice(0, 6);
---

<style>
  html {
    font-family: var(--font-sans);

    font-size: var(--text-md);
    line-height: var(--text-md--line-height);

    background-color: var(--background);
    color: var(--text);
  }

  * {
    overscroll-behavior-x: none;
  }

  ::selection {
    background: rgba(194, 230, 242, 0.5); /* seagull-200 @ 50% */
  }

  @media (prefers-color-scheme: dark) {
    ::selection {
      background: rgba(36, 96, 130, 0.5); /* seagull-700 @ 50% */
    }
  }

  .dark ::selection,
  [data-theme="dark"] ::selection {
    background: rgba(36, 96, 130, 0.5); /* seagull-700 @ 50% */
  }

  @media (prefers-color-scheme: dark) {
    .astro-code,
    .astro-code span {
      color: var(--shiki-dark) !important;
      background-color: var(--shiki-dark-bg) !important;
    }
  }

  .dark .astro-code,
  .dark .astro-code span,
  [data-theme="dark"] .astro-code,
  [data-theme="dark"] .astro-code span {
    color: var(--shiki-dark) !important;
    background-color: var(--shiki-dark-bg) !important;
  }

  .container {
    max-width: 960px;
    margin: 0 auto;

    padding: 0 1rem;
  }

  .serif {
    font-family: var(--font-serif);
  }

  .sans-serif {
    font-family: var(--font-sans);
  }

  .monospace {
    font-family: var(--font-mono);
  }

  .arrow,
  .data-footnote-backref {
    font-family: var(--font-arrow);
  }

  .theme-serif {
    font-family: var(--font-serif);
  }

  .theme-serif h1,
  .theme-serif h2,
  .theme-serif h3,
  .theme-serif h4 {
    font-family: var(--font-sans);
    color: var(--header);
  }

  img {
    max-width: 100%;
    height: auto;
  }

  h1,
  .h1 {
    font-size: var(--text-4xl);
    line-height: var(--text-4xl--line-height);
    margin-top: 2rem;
    margin-bottom: 1.5rem;
    font-weight: 800;
  }

  h2,
  .h2 {
    font-size: var(--text-2xl);
    line-height: var(--text-2xl--line-height);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-weight: 700;
  }

  h3,
  .h3 {
    font-size: var(--text-xl);
    line-height: var(--text-xl--line-height);
    margin-top: 1.6rem;
    margin-bottom: 0.6rem;
    font-weight: 700;
  }

  h4,
  .h4 {
    font-size: var(--text-md);
    line-height: var(--text-md--line-height);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    font-weight: 700;
  }

  .lead {
    font-size: var(--text-lg);
    line-height: var(--text-lg--line-height);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  blockquote {
    margin: 0;
    margin-top: 1.6rem;
    margin-bottom: 1.6rem;

    color: var(--blockquote);
    position: relative;
  }

  blockquote:before {
    content: "";
    position: absolute;
    width: 0.35rem;

    border-radius: 0.35rem;
    height: 100%;

    background-color: var(--blockquote-before);
  }

  blockquote > * {
    padding-left: 1.6rem;
  }

  p {
    margin: 1em 0;
    hyphens: auto;
  }

  small {
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
  }

  ul,
  ol {
    padding: 0;
    padding-left: 1.6em;
  }

  ul > li,
  ol > li {
    padding-left: 0.4em;
  }

  ul > li::marker {
    color: var(--ul-marker);
  }

  ol > li::marker {
    color: var(--ol-marker);
  }

  li {
    margin-top: 0.5em;
    margin-bottom: 0.5em;
  }

  hr {
    margin-top: 2.5rem;
    margin-bottom: 2.5rem;
    border: none;
    border-top: 1px solid;
    border-top-color: var(--hr);
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.93em;
  }

  code:before,
  code:after {
    content: "`";
    font-weight: 400;
  }

  pre {
    padding: 12px;
    border-radius: 8px;
    line-height: 1.45;
  }

  pre code {
    font-weight: 400;
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
  }

  pre code:before,
  pre code:after {
    content: none;
  }

  figure {
    color: var(--blockquote);
    font-size: var(--text-md);
    line-height: var(--text-md--line-height);
    margin: 0.75rem 0 2rem;
  }

  table {
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
    margin: 1.5rem 0;
    width: 100%;
    border-collapse: collapse;
  }

  thead {
    border-bottom: 1px solid;
    border-bottom-color: var(--blockquote-before);
  }

  tr {
    border-bottom: 1px solid;
    border-bottom-color: var(--hr);
  }

  th {
    color: var(--header);
    font-weight: 600;
    text-align: start;
    padding: 0.5rem;
  }

  th:first-of-type {
    padding-left: 0;
  }

  th:last-of-type {
    padding-right: 0;
  }

  td {
    color: var(--blockquote);
    padding: 0.5rem;
  }

  td:first-of-type {
    padding-left: 0;
  }

  td:last-of-type {
    padding-right: 0;
  }

  .flex-wrap-when-small {
    flex-wrap: wrap;
  }

  @media (min-width: 1024px) {
    .flex-wrap-when-small {
      flex-wrap: nowrap;
    }

    html {
      font-size: var(--text-xl);
      line-height: var(--text-xl--line-height);
    }

    h1,
    .h1 {
      font-size: var(--text-6xl);
      line-height: var(--text-6xl--line-height);
      margin-top: 3rem;
      margin-bottom: 2.5rem;
    }

    h2,
    .h2 {
      font-size: var(--text-4xl);
      line-height: var(--text-4xl--line-height);
      margin-top: 3rem;
      margin-bottom: 1.75rem;
    }

    h3,
    .h3 {
      font-size: var(--text-2xl);
      line-height: var(--text-2xl--line-height);
      margin-top: 2rem;
      margin-bottom: 1rem;
    }

    h4,
    .h4 {
      font-size: var(--text-xl);
      line-height: var(--text-xl--line-height);
      margin-top: 1.5rem;
      margin-bottom: 0.5rem;
    }

    .lead {
      font-size: var(--text-2xl);
      line-height: var(--text-2xl--line-height);
      margin-top: 1.5rem;
      margin-bottom: 0.5rem;
    }

    pre {
      line-height: 1.25;
    }

    pre code {
      font-size: var(--text-md);
    }

    small,
    figure,
    table {
      font-size: var(--text-lg);
      line-height: var(--text-lg--line-height);
    }

    th {
      padding: 0.5rem;
    }

    th:first-of-type {
      padding-left: 0;
    }

    th:last-of-type {
      padding-right: 0;
    }

    td {
      padding: 0.5rem;
    }

    td:first-of-type {
      padding-left: 0;
    }

    td:last-of-type {
      padding-right: 0;
    }
  }

  .pixelated {
    image-rendering: pixelated;
  }

  @font-face {
    font-display: swap;
    font-family: "Pretendard Arrows";
    font-style: normal;
    font-weight: 400;
    src:
      url("https://adryd.com/static/fonts/PretendardArrows-v1.eot?#iefix")
        format("embedded-opentype"),
      url("https://adryd.com/static/fonts/PretendardArrows-v1.ttf")
        format("truetype");
    unicode-range: U+2190-2199, U+21A9-21AA;
  }

  @font-face {
    font-family: "Pretendard Std Variable";
    font-weight: 45 920;
    font-style: normal;
    font-display: swap;
    src: url("https://adryd.com/static/fonts/pretendard/PretendardStdVariable.woff2?#")
      format("woff2-variations");
  }

  @font-face {
    font-family: "Pretendard Std";
    font-weight: 900;
    font-display: swap;
    src:
      url("https://adryd.com/static/fonts/pretendard/woff2/PretendardStd-Black.woff2?#")
        format("woff2"),
      url("https://adryd.com/static/fonts/pretendard/woff/PretendardStd-Black.woff?#")
        format("woff");
  }

  @font-face {
    font-family: "Pretendard Std";
    font-weight: 800;
    font-display: swap;
    src:
      url("https://adryd.com/static/fonts/pretendard/woff2/PretendardStd-ExtraBold.woff2?#")
        format("woff2"),
      url("https://adryd.com/static/fonts/pretendard/woff/PretendardStd-ExtraBold.woff?#")
        format("woff");
  }

  @font-face {
    font-family: "Pretendard Std";
    font-weight: 700;
    font-display: swap;
    src:
      url("https://adryd.com/static/fonts/pretendard/woff2/PretendardStd-Bold.woff2?#")
        format("woff2"),
      url("https://adryd.com/static/fonts/pretendard/woff/PretendardStd-Bold.woff?#")
        format("woff");
  }

  @font-face {
    font-family: "Pretendard Std";
    font-weight: 600;
    font-display: swap;
    src:
      url("https://adryd.com/static/fonts/pretendard/woff2/PretendardStd-SemiBold.woff2?#")
        format("woff2"),
      url("https://adryd.com/static/fonts/pretendard/woff/PretendardStd-SemiBold.woff?#")
        format("woff");
  }

  @font-face {
    font-family: "Pretendard Std";
    font-weight: 500;
    font-display: swap;
    src:
      url("https://adryd.com/static/fonts/pretendard/woff2/PretendardStd-Medium.woff2?#")
        format("woff2"),
      url("https://adryd.com/static/fonts/pretendard/woff/PretendardStd-Medium.woff?#")
        format("woff");
  }

  @font-face {
    font-family: "Pretendard Std";
    font-weight: 400;
    font-display: swap;
    src:
      url("https://adryd.com/static/fonts/pretendard/woff2/PretendardStd-Regular.woff2?#")
        format("woff2"),
      url("https://adryd.com/static/fonts/pretendard/woff/PretendardStd-Regular.woff?#")
        format("woff");
  }

  @font-face {
    font-display: swap;
    font-family: "Libre Baskerville";
    font-style: normal;
    font-weight: 400;
    src: url("https://adryd.com/static/fonts/libre-baskerville-v24-latin-regular.woff2#")
      format("woff2");
  }

  @font-face {
    font-display: swap;
    font-family: "Libre Baskerville";
    font-style: italic;
    font-weight: 400;
    src: url("https://adryd.com/static/fonts/libre-baskerville-v24-latin-italic.woff2#")
      format("woff2");
  }

  @font-face {
    font-display: swap;
    font-family: "Libre Baskerville";
    font-style: normal;
    font-weight: 700;
    src: url("https://adryd.com/static/fonts/libre-baskerville-v24-latin-700.woff2#")
      format("woff2");
  }

  /* libre-baskerville-700italic - latin */
  @font-face {
    font-display: swap;
    font-family: "Libre Baskerville";
    font-style: italic;
    font-weight: 700;
    src: url("https://adryd.com/static/fonts/libre-baskerville-v24-latin-700italic.woff2#")
      format("woff2");
  }

  @font-face {
    font-display: swap;
    font-family: "IBM Plex Mono";
    font-style: normal;
    font-weight: 400;
    src: url("https://adryd.com/static/fonts/ibm-plex-mono-v20-latin-regular.woff2?#")
      format("woff2");
  }

  @font-face {
    font-display: swap;
    font-family: "IBM Plex Mono";
    font-style: normal;
    font-weight: 700;
    src: url("https://adryd.com/static/fonts/ibm-plex-mono-v20-latin-700.woff2?#")
      format("woff2");
  }

  :root {
    /* Fonts */
    --font-arrow:
      "Pretendard Std", "Pretendard Arrows", apple-system, system-ui,
      "Helvetica", "Arial", sans-serif;
    --font-sans:
      "Pretendard Std", apple-system, system-ui, "Helvetica", "Arial",
      sans-serif;
    --font-serif: "Libre Baskerville", serif;
    --font-mono: "IBM Plex Mono", monospace;

    /* Type scale */
    --text-xs: 0.75rem;
    --text-xs--line-height: 1.75;
    --text-sm: 0.875rem;
    --text-sm--line-height: 1.75;
    --text-md: 1rem;
    --text-md--line-height: 1.751;
    --text-lg: 1.125rem;
    --text-lg--line-height: 1.75;
    --text-xl: 1.25rem;
    --text-xl--line-height: 1.75;
    --text-2xl: 1.5rem;
    --text-2xl--line-height: 1.75;
    --text-3xl: 1.875rem;
    --text-3xl--line-height: 1.5;
    --text-4xl: 2.25rem;
    --text-4xl--line-height: 1.25;
    --text-5xl: 3rem;
    --text-5xl--line-height: 1;
    --text-6xl: 3.75rem;
    --text-6xl--line-height: 1;
    --text-7xl: 4.5rem;
    --text-7xl--line-height: 1;
    --text-8xl: 6rem;
    --text-8xl--line-height: 1;
    --text-9xl: 8rem;
    --text-9xl--line-height: 1;

    /* Base palette */
    --color-white: #fff;
    --color-black: #000;

    --color-seagull-50: #f1fbfe;
    --color-seagull-100: #e4f6fb;
    --color-seagull-200: #c2e6f2;
    --color-seagull-300: #93d0e6;
    --color-seagull-400: #70bcda;
    --color-seagull-500: #3299c2;
    --color-seagull-600: #267aa1;
    --color-seagull-700: #246082;
    --color-seagull-800: #1f516f;
    --color-seagull-900: #1c445e;
    --color-seagull-950: #102e43;

    --color-picton-blue-50: #f1fbfe;
    --color-picton-blue-100: #e4f6fb;
    --color-picton-blue-200: #b7eeff;
    --color-picton-blue-300: #7ee0fc;
    --color-picton-blue-400: #40d0f7;
    --color-picton-blue-500: #14c3f2;
    --color-picton-blue-600: #0098c7;
    --color-picton-blue-700: #0079a2;
    --color-picton-blue-800: #0d6287;
    --color-picton-blue-900: #064d70;
    --color-picton-blue-950: #102e43;

    --color-gray-50: #fafafa;
    --color-gray-100: #f5f5f5;
    --color-gray-200: #e5e5e5;
    --color-gray-300: #d4d4d4;
    --color-gray-400: #a1a1a1;
    --color-gray-500: #737373;
    --color-gray-600: #525252;
    --color-gray-700: #404040;
    --color-gray-800: #262626;
    --color-gray-900: #171717;
    --color-gray-950: #0a0a0a;

    --color-stone-50: #fafafa;
    --color-stone-100: #f5f5f5;
    --color-stone-200: #e7e5e4;
    --color-stone-300: #d6d3d1;
    --color-stone-400: #a6a09b;
    --color-stone-500: #79716b;
    --color-stone-600: #56524d;
    --color-stone-700: #44403b;
    --color-stone-800: #292524;
    --color-stone-900: #1c1917;
    --color-stone-950: #0a0a0a;

    --color-green-300: #8cf086;
    --color-green-500: #1dcc5d;
    --color-green-700: #148051;

    --color-yellow-300: #fcd847;
    --color-yellow-500: #ebad02;
    --color-yellow-700: #b8650d;

    --color-red-300: #f77254;
    --color-red-500: #dc2626;
    --color-red-700: #981b29;

    /* Theme (light values) */
    --background: var(--color-white);
    --text: var(--color-stone-800);
    --header: var(--color-stone-900);
    --blockquote: var(--color-stone-700);
    --blockquote-before: var(--color-stone-300);
    --ol-marker: var(--color-stone-600);
    --ul-marker: var(--color-stone-400);
    --hr: var(--color-stone-200);
    --fancy-link-text: var(--color-picton-blue-800);
    --fancy-link-background: var(--color-seagull-200);
    --fancy-link-text-hover: var(--color-picton-blue-700);
    --fancy-link-background-hover: #dbeff8;
    --subtle-link-background-hover: var(--color-seagull-100);
  }

  /* ==========================================================================
   Dark theme overrides
   Applies automatically via OS/browser preference, and can be forced with
   a `.dark` class (or `[data-theme="dark"]`) on the <html>/<body> element.
   ========================================================================== */

  @media (prefers-color-scheme: dark) {
    :root {
      --background: var(--color-gray-900);
      --text: var(--color-gray-200);
      --header: var(--color-gray-100);
      --blockquote: var(--color-gray-300);
      --blockquote-before: var(--color-gray-500);
      --ol-marker: var(--color-gray-400);
      --ul-marker: var(--color-gray-500);
      --hr: var(--color-gray-700);
      --fancy-link-text: var(--color-seagull-400);
      --fancy-link-background: #2a3b45;
      --fancy-link-text-hover: var(--color-seagull-300);
      --fancy-link-background-hover: #253239;
      --subtle-link-background-hover: #253239;
    }
  }

  .dark,
  [data-theme="dark"] {
    --background: var(--color-gray-900);
    --text: var(--color-gray-200);
    --header: var(--color-gray-100);
    --blockquote: var(--color-gray-300);
    --blockquote-before: var(--color-gray-500);
    --ol-marker: var(--color-gray-400);
    --ul-marker: var(--color-gray-500);
    --hr: var(--color-gray-700);
    --fancy-link-text: var(--color-seagull-400);
    --fancy-link-background: #2a3b45;
    --fancy-link-text-hover: var(--color-seagull-300);
    --fancy-link-background-hover: #253239;
    --subtle-link-background-hover: #253239;
  }

  /* ==========================================================================
   Base rules
   ========================================================================== */

  a {
    color: inherit;
  }

  a img {
    /* Slight normalize for IE */
    border: 0;
  }

  .subtle-link {
    color: inherit;
    transition:
      color 0.1s,
      background-color 0.1s;
    text-decoration: none;
    border-radius: 4px;
    padding: 0.02em 0.2em 0.14em;
    margin: -0.02em -0.2em -0.14em;

    &:hover {
      color: inherit;
      background-color: var(--subtle-link-background-hover);
    }
  }

  a.fancy-link,
  .fancy-link a,
  .fancy-link button,
  button.fancy-link {
    background-color: var(--fancy-link-background);
    color: var(--fancy-link-text);
    transition:
      color 0.1s,
      background-color 0.1s;
    text-decoration: none;
    border-radius: 4px;
    /* Pretendard padding: 0.16em 0.3em; */
    /* Source Serif padding: 0.08em 0.3em 0.16em; */
    padding: 0.08em 0.3em 0.1em;
    margin: -0.2em 0;
    cursor: pointer;
  }

  a.fancy-link:hover,
  .fancy-link a:hover,
  .fancy-link button:hover,
  button.fancy-link:hover {
    background-color: var(--fancy-link-background-hover);
    color: var(--fancy-link-text-hover);
  }

  button.fancy-link {
    border: none;
    font-weight: inherit;
    display: inline;
  }

  a.revert-fancy-link,
  .revert-fancy-link a,
  .revert-fancy-link button {
    background-color: revert;
    color: inherit;
    transition: revert;
    text-decoration: revert;
    border-radius: 0;
    padding: revert;
    margin: revert;
    cursor: revert;
  }

  a.revert-fancy-link:hover,
  .revert-fancy-link a:hover,
  .revert-fancy-link button:hover {
    background-color: revert;
    color: inherit;
  }

  h1 {
    font-weight: 900;
    font-size: var(--text-6xl);
    line-height: var(--text-6xl--line-height);
    margin-bottom: 1rem;
  }

  .aka {
    font-weight: 500;
  }

  p {
    margin: 0.7rem 0;
  }

  h2 {
    margin-top: 1.8rem;
    margin-bottom: 1rem;
  }

  ul {
    padding-left: 0;
    padding-inline-start: 0;
    list-style: none;
  }

  ul > li {
    padding-left: 0;
    padding-inline-start: 0;
    margin-top: 0.2em;
    margin-bottom: 0.2em;
  }
  .ari {
    color: #70bcda;
  }
</style>

