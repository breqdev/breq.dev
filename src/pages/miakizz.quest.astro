                <li class="page-item disabled">
                  <a class="page-link" href="#" aria-label="previous-page"
                    ><i class="fas fa-angle-left"></i></a
                  >
                </li><li class="page-item active">
                  <a class="page-link" href="/">1</a>
                </li><li class="page-item">
                  <a class="page-link" href="/projects">2</a>
                </li><li class="page-item">
                  <a class="page-link" href="/projects">3</a>
                </li><li class="page-index align-middle">
                  <span>1</span>
                  <span class="text-muted">/ 3</span>
                </li><li class="page-item">
                  <a class="page-link" href="/projects" aria-label="next-page"
                    ><i class="fas fa-angle-right"></i></a
                  >
                </li>
              </ul>
            </nav>
          </main><aside
            aria-label="Panel"
            id="panel-wrapper"
            class="col-xl-3 ps-2 text-muted"
          >
            <div class="access">
              <section id="access-lastmod">
                <h2 class="panel-heading">Recently Updated</h2><ul
                  class="content list-unstyled ps-0 pb-1 ms-1 mt-2"
                >
                  {
                    recentlyUpdated.map((project) => (
                      <li class="text-truncate lh-lg">
                        <a href={`/projects/${project.id}/`}>
                          {project.data.title}
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </section>
            </div>
          </aside>
        </div><div class="row">
          <div id="tail-wrapper" class="col-12 col-lg-11 col-xl-9 px-md-4">
            <br /><footer
              aria-label="Site Info"
              class="text-muted"
              style="padding:12px 0"
            >
              <style>
                .badge {
                  border: none !important;
                  image-rendering: pixelated;
                }
              </style><div
                class="d-flex flex-row text-muted justify-content-center justify-content-lg-start flex-wrap"
                style="gap:5px;min-width:0;margin:0 auto"
