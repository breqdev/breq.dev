---
import { faCloudDownloadAlt } from "@fortawesome/free-solid-svg-icons";
import opengd77preview from "../../public/themes/opengd77/preview.png";
import Fonts from "../components/design/Fonts.astro";
import Color from "../components/design/Color.tsx";
import { Image } from "astro:assets";
import Page from "../layouts/Page.astro";
import FaIcon from "../components/FaIcon.astro";

const COLORGRID = [
  ["#ff8ac4", "#b0e4ff", "#ffeb7a", "#fa9f75", "#e0a1ff", "#a1ffd0"],
  [null, "#5ec9ff", null, null, null, null],
  ["#ff42a1", "#1bb3ff", "#ffda00", "#ff6b26", "#c757ff", null],
  ["#ff218c", "#0077b3", null, null, null, null],
];
---

<Page
  class="flex flex-col gap-16 bg-black text-white"
  title="breq.dev design language"
  description="colors, fonts, and logos to stay consistent."
>
  <div class="mx-auto my-8 max-w-lg text-center">
    <h1 class="font-display text-6xl">design language</h1>
  </div>

  <div>
    <h2 class="text-center font-display text-6xl">colors</h2>
    <div
      class="my-8 hidden justify-center gap-4 md:grid"
      style={{ gridTemplateColumns: `repeat(${COLORGRID[0].length}, 8rem)` }}
    >
      {
        COLORGRID.flat().map((color, i) =>
          color === null ? <span /> : <Color hex={color} client:load />,
        )
      }
    </div>
    <div
      class="my-8 grid justify-center gap-4 md:hidden"
      style={{ gridTemplateColumns: `repeat(auto-fill, 8rem)` }}
    >
      {
        COLORGRID.flat()
          .filter((c) => c !== null)
          .map((color, i) => <Color hex={color!} />)
      }
    </div>
  </div>

  <div>
    <h2 class="text-center font-display text-6xl">fonts</h2>
    <div class="my-16 flex flex-col gap-8">
      <Fonts name="Nunito" comment="for display text" />
      <Fonts name="Libre Franklin" comment="for body text" />
      <Fonts name="Fira Code" comment="for code" />
      <Fonts name="Nunito Sans" comment="for formal settings" />
    </div>
  </div>

  <div class="mx-auto max-w-7xl">
    <h2 class="text-center font-display text-6xl">themes</h2>
    <div
      class="my-4 grid grid-cols-1 justify-center gap-8 rounded-2xl bg-black p-2 md:grid-cols-2 lg:grid-cols-3"
    >
      <div
        class="flex w-full max-w-sm flex-col gap-2 overflow-clip rounded-xl bg-white p-1 pb-2 text-black"
      >
        <Image
          class="w-full rounded-lg"
          src={opengd77preview}
          alt="OpenGD77"
          style={{ imageRendering: "pixelated" }}
        />
        <h2 class="mx-2 text-center font-display text-2xl">OpenGD77</h2>
        <p class="mx-4 text-center font-body">
          for the{" "}
          <a class="underline" href="https://www.opengd77.com/"> OpenGD77 </a>{
            " "
          }
          firmware on my Retevis RT3S handheld radio
        </p>
        <a
          href="/themes/opengd77/theme.gtm"
          class="mx-2 rounded-lg bg-panblue-light p-1 text-center font-display text-lg transition-colors hover:bg-panblue"
        >
          <FaIcon icon={faCloudDownloadAlt} /> download
        </a>
      </div>
    </div>
  </div>
</Page>
