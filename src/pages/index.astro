---
import { faArrowRight, faChevronDown } from "@fortawesome/free-solid-svg-icons";
import AboutContent from "../components/AboutContent.astro";
import FaIcon from "../components/FaIcon.astro";
import Greeting from "../components/Greeting.astro";
import HCard from "../components/HCard.astro";
import ScrollDownHint from "../components/homepage/ScrollDownHint";
import Page from "../layouts/Page.astro";
import CubeLightsAnim from "../components/homepage/CubeLightsAnim";
import { getCollection } from "astro:content";
import ProjectCard from "../components/ProjectCard.astro";

const projects = await getCollection("projects");

const displayedProjects = projects
  .filter((p) => p.data.video || p.data.image)
  .sort((a, b) => b.data.writeup.getTime() - a.data.writeup.getTime())
  .slice(0, 12);

function generateBreakpointClass(index: number) {
  if (index < 3) return "block";
  if (index < 6) return "hidden md:block";
  if (index < 9) return "hidden lg:block";
  if (index < 12) return "hidden xl:block";
}

