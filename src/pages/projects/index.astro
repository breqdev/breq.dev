---
import { faRssSquare } from "@fortawesome/free-solid-svg-icons";
import FaIcon from "../../components/FaIcon.astro";
import Page from "../../layouts/Page.astro";
import { getCollection } from "astro:content";
import ProjectCard from "../../components/ProjectCard.astro";

const projects = await getCollection("projects");

const groups: Record<number, typeof projects> = {};

projects.forEach((project) => {
  const group = project.data.created;

  if (!(group in groups)) {
    groups[group] = [];
  }

  groups[group].push(project);
});
---

<Page title="Project Portfolio - breq.dev" class="bg-black text-white">
  <div class="mx-auto max-w-7xl text-center font-display">
    <h1 class="mb-2 mt-8 text-6xl">project portfolio</h1>
    <p class="mb-8 text-xl">
      available via{" "}
      <a
        href="https://breq.dev/rss.xml"
        class="font-bold text-orange-300 hover:underline"
      >
        <FaIcon icon={faRssSquare} class="-mb-px -mr-0.5 ml-0.5" />{" "}
        rss
      </a>
    </p>
    {
      Object.entries(groups)
        .sort(([a, _], [b, __]) => parseInt(b) - parseInt(a))
        .map(([year, projects]) => (
          <div class="flex flex-col">
            <hr class="mx-16 -mb-5 mt-4" />
            <h2 class="-mb-4 text-4xl">
              <span class="bg-black px-2">{year}</span>
            </h2>
            <div class="place-stretch m-8 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
              {projects.map((project) => (
                <ProjectCard project={project} />
              ))}
            </div>
          </div>
        ))
    }
  </div>
</Page>
